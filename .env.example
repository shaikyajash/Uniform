# RPC endpoints
WHITECHAIN_RPC_URL=https://rpc.ankr.com/whitechain_testnet
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Keys (never commit real values)
DEPLOYER_PRIVATE_KEY=
GAS_PAYER_PRIVATE_KEY=
MATCHMAKER_PRIVATE_KEY=

# Explorer verification
ETHERSCAN_API_KEY=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=

# Order Desk
ORDER_DESK_URL=http://localhost:4000
DATABASE_URL=postgres://YOUR_USER@localhost/uniform
PORT=4000
PAY_BASE_URL=http://localhost:3000
CHAINS_JSON=../shared/chains.json
# Shared with the Matchmaker; at least 32 characters, e.g. openssl rand -hex 32
INTERNAL_EVENTS_TOKEN=
# Refunds for source locks Bob never filled: wait this long after expiry (the Matchmaker refunds
# its own fills first), checking this often. Defaults are fast for the demo.
REFUND_GRACE_SECONDS=30
REFUND_SWEEP_SECONDS=5

# Relayer: sends the Order Desk's jobs and pays the gas (uses DATABASE_URL and CHAINS_JSON above)
# The key that signs and pays gas. Never commit it.
RELAYER_PRIVATE_KEY=
# Optional: a different RPC for the shop chain, e.g. http://localhost:8545 for an anvil copy
SHOP_CHAIN_RPC=
# The largest order it pays gas for, in USDT
RELAYER_MAX_ORDER_USDT=100
# Gas per shop per UTC day, in wei (0.05 WBT)
RELAYER_DAILY_GAS_WEI=50000000000000000
